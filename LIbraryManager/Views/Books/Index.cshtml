@model IEnumerable<LIbraryManager.Models.Book>
@{
    ViewData["Title"] = "Book Catalog";
    bool isLibrarian = User.IsInRole("Librarian");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Library Book Catalog</h2>
    @if (isLibrarian)
    {
        <a asp-action="Create" class="btn btn-primary">+ Add New Book</a>
    }
</div>

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-6">
        <input type="text" name="searchString" value="@ViewBag.CurrentFilter" class="form-control" placeholder="Search by title, author, ISBN, or category..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ISBN</th>
            <th>Title</th>
            <th>Author</th>
            <th>Category</th>
            <th>Available / Total</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ISBN</td>
                <td><strong>@item.Title</strong></td>
                <td>@item.Author</td>
                <td><span class="badge bg-info text-dark">@item.Category</span></td>
                <td>
                    @if (item.AvailableCopies > 0)
                    {
                        <span class="badge bg-success">@item.AvailableCopies / @item.TotalCopies</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">0 / @item.TotalCopies (Out)</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.BookId" class="btn btn-sm btn-outline-info">Details</a>
                    @if (isLibrarian)
                    {
                        <a asp-action="Edit" asp-route-id="@item.BookId" class="btn btn-sm btn-outline-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.BookId" class="btn btn-sm btn-outline-danger">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>